# ============================================================
# DevForge — Variables de entorno de ejemplo
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env.local
#   2. Completa los valores reales en .env.local
#   3. NUNCA subas .env.local al repositorio (ya está en .gitignore)
# ============================================================

# ─── App ─────────────────────────────────────────────────────
VITE_APP_NAME=DevForge
VITE_APP_URL=http://localhost:5173

# ─── Google reCAPTCHA (Mejora 18) ────────────────────────────
# Obtener en: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# ─── Google OAuth (Mejora 36) ────────────────────────────────
# Obtener en: https://console.cloud.google.com/apis/credentials
# NOTA: En Vite, NO expongas el CLIENT_SECRET en el frontend
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── Stripe (Mejora 46) ──────────────────────────────────────
# Clave pública (segura en frontend), clave secreta SOLO en backend
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ─── WhatsApp Cloud API (Mejora 51) ──────────────────────────
# NOTA: El WHATSAPP_TOKEN es secreto — usar SOLO en el backend
# VITE_ prefix para el Phone Number ID (no es un secret)
VITE_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ─── OpenAI (Mejora 65) ──────────────────────────────────────
# NOTA: La API key es un secret — usar SOLO en el backend
# NUNCA uses VITE_ prefix para secrets

# ─── Analytics (Mejora 93) ───────────────────────────────────
VITE_ANALYTICS_ENABLED=false
